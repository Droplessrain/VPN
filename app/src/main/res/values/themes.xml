<resources>
    <style name="Theme.V2rayExample" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="android:statusBarColor">@color/gray</item>
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:editTextColor">@color/white</item>
        <item name="android:textColorHint">#99FFFFFF</item>
        <item name="configInputBackground">@drawable/config_editor_bg_dark</item>
    </style>

    <style name="Theme.V2rayExample.Light" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="android:statusBarColor">@color/purple_500</item>
        <item name="android:windowBackground">@color/white</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:editTextColor">@color/black</item>
        <item name="android:textColorHint">#99000000</item>
        <item name="configInputBackground">@drawable/config_editor_bg_light</item>
    </style>
</resources>
