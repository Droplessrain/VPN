<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_space">

    <dev.dev7.example.GlobeNetworkView
        android:id="@+id/globe_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <Button
        android:id="@+id/btn_settings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="@drawable/btn_settings_round"
        android:minHeight="40dp"
        android:text="@string/btn_settings"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="13sp"
        app:backgroundTint="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="24dp">

        <Button
            android:id="@+id/btn_connect"
            android:layout_width="168dp"
            android:layout_height="168dp"
            android:background="@drawable/btn_connect_round"
            android:elevation="8dp"
            android:gravity="center"
            android:text="@string/btn_connect"
            android:textAllCaps="false"
            android:textColor="#0B1B2B"
            android:textSize="18sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

        <Spinner
            android:id="@+id/country_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="#553A5F7A"
            android:padding="10dp"
            android:popupTheme="@style/ThemeOverlay.AppCompat.Light"
            android:spinnerMode="dropdown" />

        <TextView
            android:id="@+id/home_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/home_status_idle"
            android:textColor="#CCE8F6FF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/no_countries_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/no_favorite_countries"
            android:textColor="#99E8F6FF"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
